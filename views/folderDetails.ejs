<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Uploader</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://kit.fontawesome.com/967516047d.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <%- include("partials/header") %>
    <div class="app-container">
      <%- include("partials/sidebar") %>
      <main class="main-container">
          <h1 class="dashboard-title"><strong><%= folder.name %></strong></h1>
          <div class="file-list">
          <div class="file-list-header">
            <span class="col-name">Name</span>
            <span class="col-size">Size</span>
            <span class="col-date">Created</span>
            <span class="col-actions"></span>
          </div>
          <% folder.files.forEach((file)=>{ %>
             <div class="file-row">
              <div class="col-name file-title">
                <span class="file-icon"><%- getFileIcon(file.name) %></span>
                <span><%= file.name %></span>
              </div>
              <span class="col-size"><%= formatFileSize(file.size) %></span>
              <span class="col-date"><%= new Date(file.createdAt).toLocaleDateString() %></span>
              <div class="col-actions">
                <a href="/files/<%= file.id %>/download" class="btn-action">Download</a>
                <form action="/files/<%= file.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this file?');">
                  <button type="submit" class="btn-danger">Delete</button>
                </form>
              </div>
            </div>
          <% }) %>
      </main>
    </div>
  </body>
</html>
