<aside>
     <button onclick="openUploadFileDialog()"><i class="fa-solid fa-file-arrow-up fa-lg"></i>Upload file</button>
     
        <dialog id="uploadFileDialog">
            <form action="<%= uploadAction %>" method="POST" enctype="multipart/form-data">
              <h3>New File</h3>
              <input type="file" name="uploadedFile">
              <div class="modal-actions">
                <button type="button" onclick="closeUploadFileDialog()">Close</button>
                <button type="submit">Upload File</button>
              </div>
            </form>
        </dialog>

        <button onclick="openNewFolderDialog()"><i class="fa-solid fa-folder-plus fa-lg"></i>New Folder</button>
        <dialog id="newFolderDialog" data-open-on-error="<%= typeof openFolderModal !== 'undefined' && openFolderModal ? 'true' : 'false' %>">
          <form id="newFolderForm" action="/folders" method="POST">
            <h3>New Folder</h3>
            <%- include('./validationErrors') %>
            <input type="text" name="name" id="newFolderInput" required>
            <div class="modal-actions">
              <button type="button" onclick="closeNewFolderDialog()">Cancel</button>
              <button type="submit">Create Folder</button>
            </div>
          </form>
        </dialog>

        <dialog id="editFolderDialog">
          <form id="editFolderForm" method="POST">
            <h3>Edit Name</h3>
            <input type="text" name="name" id="editFolderInput" required>
            <div class="modal-actions">
              <button type="button" onclick="closeEditFolderDialog()">Cancel</button>
              <button type="submit">Update</button>
            </div>
          </form>
        </dialog>

        <dialog id="shareFolderDialog">
          <form id="shareFolderForm" method="POST">
            <h3>Share Folder</h3>
            <label for="duration">Link Expiration:</label>
            <select name="duration" id="duration" required>
              <option value="1d">1 Day</option>
              <option value="7d">7 Days</option>
              <option value="30d">30 Days</option>
            </select>
            <div class="modal-actions">
              <button type="button" onclick="closeShareFolderDialog()">Cancel</button>
              <button type="submit">Generate Link</button>
            </div>
          </form>
        </dialog>
        
        <ul>
          <% folders.forEach(folder => { %>
            <li class="folder-item <%= (typeof currentFolderId !== 'undefined' && currentFolderId.toString() === folder.id.toString()) ? 'active' : '' %>">
              <a href="/folders/<%= folder.id %>"><span><%= folder.name %></span></a>
              <button type="button" onclick="openEditFolderDialog('<%= folder.id %>', '<%= folder.name %>')"><i class="fa-solid fa-pen-to-square"></i></button>
              <button type="button" onclick="openShareFolderDialog('<%= folder.id %>')"><i class="fa-solid fa-share"></i></button>
              <form action="/folders/<%= folder.id %>/delete" method="POST">
                <button type="submit"><i class="fa-solid fa-trash"></i></button>
              </form>
            </li>
         <% }); %>
        </ul>
</aside>
 <script src="/js/folderDialogs.js" defer></script>
